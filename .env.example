RMP_USERNAME=
# Rotate this if it was ever pasted into chat or if RMP shows
# [authorization_request_not_found] after aggressive scraping.
# Put the NEW password here in repo-root .env (never commit .env).
RMP_PASSWORD=
RMP_START_DATE=2026-02-01

# Rate limits (seconds). Defaults are ~60s between hits to avoid RMP bans.
# Random jitter between min and max on every page/API/download action.
RMP_MIN_DELAY_SEC=60
RMP_MAX_DELAY_SEC=75
# Extra pause after file downloads
RMP_DOWNLOAD_EXTRA_SEC=15
# Base for exponential backoff on errors / HTTP 429 / auth failures
RMP_ERROR_BACKOFF_SEC=120
